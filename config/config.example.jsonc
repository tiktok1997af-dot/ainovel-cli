{
  // WEB-only AI runtime. ainovel opens a visible Chrome window and uses the
  // Gemini website session that YOU log into. No AI API key is used or stored.
  "web": {
    "enabled": true,
    "site": "gemini-web",

    // Optional. Leave blank/omit to auto-detect Google Chrome.
    // Windows example:
    // "browser_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",

    // Persistent Chrome data profile owned by ainovel. Login cookies remain in
    // Chrome's profile directory; they are not copied into novel/project files.
    "profile_name": "default"

    // start_url is optional; Gemini Web is used by default.
    // "start_url": "https://gemini.google.com/app"
  },

  // Creative language: "vi" (Vietnamese, default) or "zh" (Chinese).
  // The TUI itself remains Vietnamese.
  "language": "vi",

  // Optional reasoning guidance for agents. This is semantic prompt intent,
  // not an API provider/model selector.
  "reasoning_effort": "medium",

  // Creative style preset.
  "style": "default",

  // Optional local context-compaction budget. This is an ainovel local limit,
  // not an AI API context-window declaration.
  "context_window": 200000

  // Optional system notifications.
  // "notify": {
  //   "enabled": true,
  //   "events": ["run_end", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }

  // No providers/api_key/base_url/AI API model list belongs in a WEB-only config.
  // Legacy provider-shaped configs are retained only for the W5C migration gate
  // and are rejected when web.enabled=true.
}
